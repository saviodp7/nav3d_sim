{
  "configurations": [
    {
      "browse": {
        "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db",
        "limitSymbolsToIncludedHeaders": true,
        "path": [
          "${workspaceFolder}/ros2_ws/src/nav3d/**",
          "/opt/ros/humble/include/**",
          "/usr/include/**"
        ]
      },
      "includePath": [
        "${workspaceFolder}/ros2_ws/src/nav3d/**",
        "/opt/ros/humble/include/**",
        "/usr/include/**"
      ],
      "name": "ros2",
      "intelliSenseMode": "gcc-x64",
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "gnu11",
      "cppStandard": "c++17"
    }
  ],
  "version": 4
}
